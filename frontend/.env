# URL del backend Flask.
#
# Vacío (recomendado para intranet): el frontend consume /api en el mismo
# origen donde está publicado el sitio (IIS, Nginx, etc. redirige /api al
# backend Flask). En desarrollo, Vite reenvía /api a API_PROXY_TARGET.
VITE_API_URL=

# Destino del proxy de desarrollo (solo `npm run dev`).
API_PROXY_TARGET=http://localhost:5000

# Modo demostración con datos de ejemplo (localStorage). NUNCA en producción.
# VITE_MODO_DEMO=true
