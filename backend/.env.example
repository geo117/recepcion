# ============================================================================
# Plantilla de configuración del backend
# Copia este archivo como .env y completa los valores.
# ============================================================================

# Entorno de ejecución.
#   development -> servidor de Flask, con recarga si RECARGA_AUTOMATICA=true
#   production  -> Waitress (servidor WSGI de producción)
# En el servidor debe quedar "production".
FLASK_ENV=production

# Recarga automática al editar código. Solo aplica con FLASK_ENV=development.
RECARGA_AUTOMATICA=false
HOST=127.0.0.1
PUERTO=5000

# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_ALEATORIA_DE_64_CARACTERES
JWT_EXPIRACION_HORAS=8

DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVIDOR=localhost\SQLEXPRESS
DB_BASE=recepcion_bd
DB_USUARIO=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_CERT=yes
DB_TIEMPO_ESPERA=5

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173

MAX_CONTENT_LENGTH_MB=6
FOTO_MAX_MB=2
RANGO_REPORTE_MAX_DIAS=366

LOGIN_INTENTOS_MAXIMOS=5
LOGIN_VENTANA_SEGUNDOS=300
